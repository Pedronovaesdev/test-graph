# Scripts precisam de LF mesmo em clones no Windows (core.autocrlf=true),
# senao o bash quebra com "\r: command not found".
*.sh      text eol=lf
gradlew   text eol=lf
mvnw      text eol=lf
*.bat     text eol=crlf
*.cmd     text eol=crlf
*.jar     binary
*.pptx    binary

# Bundle gerado pelo esbuild: LF em qualquer SO (o CI compara byte a byte com
# um build novo) e recolhido nos diffs de PR.
selector/dist/cli.js text eol=lf linguist-generated=true
